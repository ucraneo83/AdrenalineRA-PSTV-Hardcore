if(ADRENALINE_PROFILE STREQUAL "standard")
  set(ADRENALINE_TEST_PROFILE 0)
  set(ADRENALINE_MODULE_SUFFIX "")
  set(ADRENALINE_TITLEID "PSPEMUCFW")
  set(ADRENALINE_APP_NAME "Adrenaline")
  set(ADRENALINE_VPK_NAME "Adrenaline.vpk")
  set(ADRENALINE_RA_DATA_DIR "AdrenalineRA")
elseif(ADRENALINE_PROFILE STREQUAL "test")
  set(ADRENALINE_TEST_PROFILE 1)
  set(ADRENALINE_MODULE_SUFFIX "Test")
  set(ADRENALINE_TITLEID "ADRA00001")
  set(ADRENALINE_APP_NAME "AdrenalineRA Test")
  set(ADRENALINE_VPK_NAME "AdrenalineRA-Test.vpk")
  set(ADRENALINE_RA_DATA_DIR "AdrenalineRA-Test")
else()
  message(FATAL_ERROR "Unknown ADRENALINE_PROFILE: ${ADRENALINE_PROFILE}")
endif()

string(LENGTH "${ADRENALINE_TITLEID}" adrenaline_title_id_length)
if(NOT adrenaline_title_id_length EQUAL 9 OR NOT ADRENALINE_TITLEID MATCHES "^[A-Z0-9]+$")
  message(FATAL_ERROR "Adrenaline Title ID must contain nine uppercase letters or digits")
endif()

if(CMAKE_SCRIPT_MODE_FILE)
  if(NOT DEFINED ADRENALINE_IDENTITY_INCLUDE_DIR OR ADRENALINE_IDENTITY_INCLUDE_DIR STREQUAL "")
    message(FATAL_ERROR "Set ADRENALINE_IDENTITY_INCLUDE_DIR to a separate output directory")
  endif()
else()
  set(ADRENALINE_IDENTITY_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/adrenaline_identity.h.in"
               "${ADRENALINE_IDENTITY_INCLUDE_DIR}/adrenaline_identity.h" @ONLY)

foreach(component IN ITEMS kernel user vsh usbdevice)
  configure_file("${CMAKE_CURRENT_LIST_DIR}/../${component}/exports.yml.in"
                 "${ADRENALINE_IDENTITY_INCLUDE_DIR}/${component}-exports.yml" @ONLY)
endforeach()
